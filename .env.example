# 使いたいプロバイダーのAPIキーだけ設定すれば動きます（複数設定すると画面で切り替えられます）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# 既定モデルの上書き（任意）
# OPENAI_MODEL=gpt-6-sol
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-3.8-flash
# DEEPSEEK_MODEL=deepseek-chat

# APIのURLの上書き（任意。プロキシや互換サーバーを使う場合）
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 公開サーバーに置く場合はBasic認証を設定してください（両方設定したときのみ有効）
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
